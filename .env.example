# ==============================================================================
# TikTokUp Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# General
PROJECT_NAME=tiktokup
APP_NAME=tiktokup-backend
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=info

# Host Port Bindings (mapped by Docker Compose)
# Defaults avoid conflicts with common host ports (80, 5432, 8080)
NGINX_PORT=8000
BACKEND_PORT=8081
FRONTEND_PORT=3000
POSTGRES_PORT=5433

# PostgreSQL 18
POSTGRES_USER=tiktokup
POSTGRES_PASSWORD=tiktokup_secret
POSTGRES_DB=tiktokup
POSTGRES_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_AUTO_MIGRATE=true

# Backend (Go 1.26)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
SERVER_READ_TIMEOUT_SECONDS=15
SERVER_WRITE_TIMEOUT_SECONDS=30
SERVER_IDLE_TIMEOUT_SECONDS=60
SERVER_SHUTDOWN_TIMEOUT_SECONDS=10

# Frontend (Next.js)
NEXT_PUBLIC_APP_NAME=TikTokUp
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://backend:8080
